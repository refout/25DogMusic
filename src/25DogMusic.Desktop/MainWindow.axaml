<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:local="using:_25DogMusic.Desktop"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="_25DogMusic.Desktop.MainWindow"
        Title="25DogMusic · 飞牛音乐"
        Icon="/Assets/appicon.ico"
        Width="1280" Height="840" MinWidth="1040" MinHeight="660"
        Background="{DynamicResource PageBg}">
  <Window.Resources>
    <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">20</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">20</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">10</CornerRadius>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavHover}" />
    </Style>
    <Style Selector="Button.nav:pressed">
      <Setter Property="Background" Value="{DynamicResource NavPressed}" />
    </Style>
    <Style Selector="Button.nav TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NavText}" />
    </Style>
    <Style Selector="ic|SymbolIcon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource NavIcon}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
    </Style>
    <Style Selector="Button.nav.active ic|SymbolIcon.navicon">
      <Setter Property="Foreground" Value="{DynamicResource NavActiveIcon}" />
    </Style>
    <Style Selector="TextBlock.navlabel">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource NavLabel}" />
      <Setter Property="Margin" Value="12,8,0,4" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <!-- 折叠按钮与搜索框同高（32px）并垂直对齐 -->
    <Style Selector="Button#SidebarToggle">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,2,6" />
    </Style>
    <!-- 侧栏折叠：只保留图标，文案、歌单区与搜索框隐藏 -->
    <Style Selector="Border#SidebarPane.collapsed">
      <Setter Property="Padding" Value="8,16" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Button#SidebarToggle">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Button.nav">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Button.nav StackPanel">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Button.nav TextBlock">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Grid#PlaylistSection">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed StackPanel#SidebarPlaylists">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed Border#PlaylistCreateBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border#SidebarPane.collapsed TextBlock#StatusText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHover}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavPressed}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.transport:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Button.transport:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Button.transport /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayerSurface}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolHover}" />
    </Style>
    <Style Selector="Button.transport:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolPressed}" />
    </Style>
    <Style Selector="Button.playmain /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayBtnBg}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.playmain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayHover}" />
    </Style>
    <Style Selector="Button.playmain:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayPressed}" />
    </Style>
    <Style Selector="Button.playmain">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.playmain:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Button.playmain:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolHover}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolPressed}" />
    </Style>
    <Style Selector="Button.pill /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillBg}" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillHover}" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillPressed}" />
    </Style>
    <Style Selector="Button.genre" >
      <Setter Property="Background" Value="{DynamicResource GenreBg}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.genre /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GenreBg}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.genre:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GenreHover}" />
    </Style>
    <Style Selector="Button.genre:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GenrePressed}" />
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.swatch /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PrimaryPressed}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostBg}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostHover}" />
      <Setter Property="Foreground" Value="{DynamicResource GhostFg}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource GhostBg}" />
      <Setter Property="Foreground" Value="{DynamicResource GhostFg}" />
    </Style>
    <Style Selector="Button.playmain">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="46" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="23" />
      <Setter Property="Background" Value="{DynamicResource PlayBtnBg}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.08)" />
    </Style>
    <Style Selector="Button.tool:pressed">
      <Setter Property="RenderTransform" Value="scale(0.92)" />
    </Style>
    <Style Selector="Button.genre">
      <Setter Property="Background" Value="{DynamicResource GenreBg}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <!-- 纯文字超链接：无背景、无边框、无最小高度，仅显示下划线文本 -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.pill">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Background" Value="{DynamicResource PillBg}" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.searchtab">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.searchtab /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillBg}" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseInOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.searchtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillHover}" />
    </Style>
    <Style Selector="Button.searchtab:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PillPressed}" />
    </Style>
    <Style Selector="Button.searchtab.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.searchtab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="Button.searchtab TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.searchtab.active TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
    </Style>

    <Style Selector="Button.pill.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayBtnBg}" />
    </Style>
    <Style Selector="Button.pill.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayBtnBg}" />
      <Setter Property="Opacity" Value="0.86" />
    </Style>
    <Style Selector="Button.pill.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PlayBtnBg}" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="TextBox.form">
      <Setter Property="Background" Value="{DynamicResource InputBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBox#SearchBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox#SearchBox /template/ Border">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{DynamicResource PrimaryPressed}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource GhostBg}" />
      <Setter Property="Foreground" Value="{DynamicResource GhostFg}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="{DynamicResource GhostHover}" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{DynamicResource PlayerFg}" />
      <Setter Property="Background" Value="{DynamicResource SliderRail}" />
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    </Style>
    <Style Selector="Border.glassglow">
      <Style.Animations>
        <Animation Duration="0:0:9" IterationCount="Infinite">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.1" />
          </KeyFrame>
          <KeyFrame Cue="50%">
            <Setter Property="Opacity" Value="0.32" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid x:Name="RootGrid">
    <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.28" />
    <Border x:Name="BackdropShade" Background="{DynamicResource BackdropShade}" />

    <Border x:Name="GlassSheen" IsVisible="False" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#08FFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="0.4" />
          <GradientStop Color="#0AFFFFFF" Offset="0.72" />
          <GradientStop Color="#0DFF5F7F" Offset="0.9" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border x:Name="GlassGlow" Classes="glassglow" IsVisible="False" IsHitTestVisible="False" Opacity="0.3">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,60%">
          <GradientStop Color="#1FFFFFFF" Offset="0" />
          <GradientStop Color="#00FFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border x:Name="GlassEdge" IsVisible="False" IsHitTestVisible="False" BorderThickness="1">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#40FFFFFF" Offset="0" />
          <GradientStop Color="#08FFFFFF" Offset="0.45" />
          <GradientStop Color="#2EFFFFFF" Offset="1" />
        </LinearGradientBrush>
      </Border.BorderBrush>
    </Border>

    <Grid RowDefinitions="*,Auto">
      <Grid x:Name="SidebarRoot" Grid.Row="0" ColumnDefinitions="248,*">
        <Border x:Name="SidebarPane" Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}"
                BorderThickness="1" CornerRadius="14" Padding="16,20" Margin="10,10,6,10">
          <Grid RowDefinitions="Auto,*,Auto">
            <Grid Grid.Row="0">
              <Border x:Name="SearchPane" Background="Transparent"
                      BorderThickness="0" CornerRadius="9" Padding="10,7,32,7" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*">
                  <ic:SymbolIcon Symbol="Search" FontSize="14" Foreground="{DynamicResource TextMuted}"
                                 VerticalAlignment="Center" />
                  <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource TextPrimary}"
                           PlaceholderText="搜索歌曲、专辑" FontSize="13" Margin="8,0,0,0"
                           VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
              </Border>

              <Button x:Name="SidebarToggle" Classes="tool" ToolTip.Tip="折叠侧栏">
                <ic:SymbolIcon x:Name="SidebarToggleIcon" Symbol="ChevronLeft" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
              </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="2">
                <Button x:Name="NavHome" Classes="nav" ToolTip.Tip="首页">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Home" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="首页" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavFavorites" Classes="nav" ToolTip.Tip="收藏">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Heart" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="收藏" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavRecent" Classes="nav" ToolTip.Tip="最近">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Clock" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="最近" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavAlbums" Classes="nav" ToolTip.Tip="专辑">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Album" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="专辑" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavArtists" Classes="nav" ToolTip.Tip="歌手">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Person" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="歌手" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavGenres" Classes="nav" ToolTip.Tip="风格">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Grid" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="风格" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavLibrary" Classes="nav" ToolTip.Tip="音乐库">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Library" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="音乐库" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Button x:Name="NavFolders" Classes="nav" ToolTip.Tip="文件夹">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ic:SymbolIcon Symbol="Folder" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="文件夹" FontSize="13.5" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Grid x:Name="PlaylistSection" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                  <TextBlock Text="歌单" Classes="navlabel" Margin="12,6,0,4" VerticalAlignment="Center" />
                  <Button x:Name="PlaylistAddButton" Grid.Column="1" Classes="tool" Width="24" Height="24"
                          Margin="0,0,6,0" ToolTip.Tip="新建歌单">
                    <ic:SymbolIcon Symbol="Add" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                  </Button>
                </Grid>

                <Border x:Name="PlaylistCreateBar" IsVisible="False" Background="{DynamicResource InputBg}"
                        BorderThickness="0" CornerRadius="9" Padding="8,6" Margin="6,2,0,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="PlaylistNameBox" BorderThickness="0" Background="Transparent" FontSize="12.5"
                             PlaceholderText="新歌单名称" VerticalAlignment="Center" />
                    <Button x:Name="PlaylistCreateButton" Grid.Column="1" Content="创建" FontSize="11.5"
                            Padding="10,5" Margin="6,0,0,0" />
                  </Grid>
                </Border>

                <StackPanel x:Name="SidebarPlaylists" Spacing="1" Margin="0,2,0,0" />
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="2" Margin="0,8,0,0">
              <Button x:Name="NavSettings" Classes="nav" ToolTip.Tip="设置">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <ic:SymbolIcon Symbol="Settings" Classes="navicon" FontSize="17" VerticalAlignment="Center" />
                  <TextBlock Text="设置" FontSize="13.5" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <TextBlock x:Name="StatusText" IsVisible="False" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                         TextWrapping="Wrap" Margin="4,4,0,0" MaxLines="4" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <ScrollViewer x:Name="ContentScroll" Margin="30,24,30,8" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="14" Margin="0,0,6,0" />
          </ScrollViewer>

          <!-- 列表页：标题固定，仅列表区域滚动 -->
          <Grid x:Name="ListPageHost" IsVisible="False" RowDefinitions="Auto,*" Margin="30,24,30,8">
            <StackPanel Grid.Row="0" x:Name="ListHeader" Spacing="6" Margin="0,0,6,0" />
            <ScrollViewer Grid.Row="1" x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <StackPanel x:Name="ListRows" Spacing="2" Margin="0,0,6,0" />
            </ScrollViewer>
          </Grid>

          <!-- 播放列表：浮层覆盖在内容之上，不占布局，下层界面仍可操作 -->
          <Border x:Name="QueuePanel" IsVisible="False" Width="372" ZIndex="10"
                  HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}"
                  BorderThickness="1" CornerRadius="14" Margin="0,10,10,10" Padding="18,14"
                  BoxShadow="0 12 32 0 #40000000">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="播放列表" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock x:Name="QueuePanelCount" FontSize="11" Foreground="{DynamicResource TextMuted}"
                             VerticalAlignment="Bottom" Margin="0,0,0,2" />
                </StackPanel>
                <Button x:Name="QueuePanelClose" Grid.Column="1" Classes="transport">
                  <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </Button>
              </Grid>

              <ScrollViewer Grid.Row="1" x:Name="QueuePanelScroll" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel x:Name="QueuePanelRows" Spacing="2" />
              </ScrollViewer>

              <Button Grid.Row="2" x:Name="QueuePanelClear" Content="清空列表" Classes="pill"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0" />
            </Grid>
          </Border>

          <!-- 添加歌曲：与播放列表同位置的侧边抽屉 -->
          <Border x:Name="PickerPanel" IsVisible="False" Width="372" ZIndex="10"
                  HorizontalAlignment="Right" VerticalAlignment="Stretch"
                  Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}"
                  BorderThickness="1" CornerRadius="14" Margin="0,10,10,10" Padding="18,14"
                  BoxShadow="0 12 32 0 #40000000">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="添加到歌单" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock x:Name="PickerPanelName" FontSize="11" Foreground="{DynamicResource TextMuted}"
                             VerticalAlignment="Bottom" Margin="0,0,0,2" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="PickerPanelClose" Grid.Column="1" Classes="transport">
                  <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                </Button>
              </Grid>

              <TextBox x:Name="PickerSearchBox" Grid.Row="1" Classes="form" Margin="0,10,0,0"
                       PlaceholderText="搜索歌曲（回车确认）" />

              <ScrollViewer Grid.Row="2" x:Name="PickerPanelScroll" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel x:Name="PickerPanelRows" Spacing="2" />
              </ScrollViewer>

              <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
                <TextBlock x:Name="PickerPanelSummary" Text="已选 0 首" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <Button x:Name="PickerPanelCancel" Grid.Column="1" Content="取消" Classes="pill"
                        Height="34" Margin="0,0,8,0" />
                <Button x:Name="PickerPanelAdd" Grid.Column="2" Content="添加" Classes="pill accent"
                        Height="34" Foreground="{DynamicResource PlayBtnFg}" IsEnabled="False" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="PlayerBar" Grid.Row="1" Background="{DynamicResource PlayerBg}" BorderBrush="{DynamicResource PlayerBorder}" BorderThickness="1" CornerRadius="14" Margin="10,0,10,10" Padding="20,8,26,10">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,86">
            <Slider x:Name="SeekSlider" Minimum="0" Maximum="100" Value="0" MinHeight="30" VerticalAlignment="Center" />
            <TextBlock x:Name="ClockText" Grid.Column="1" Text="00:00 / 00:00" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PlayerMuted}" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto">
              <Border x:Name="NowClickArea" CornerRadius="8" ClipToBounds="True" Width="46" Height="46" Background="{DynamicResource PlayerSurface}">
                <Grid>
                  <ic:SymbolIcon Symbol="MusicNote2" FontSize="18" Foreground="{DynamicResource PlayerMuted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="NowCover" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2" MaxWidth="280">
                <TextBlock x:Name="NowTitle" Text="未在播放" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NowSub" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,14,0">
              <Button x:Name="ShuffleButton" Classes="transport">
                <ic:SymbolIcon x:Name="ShuffleIcon" Symbol="ArrowShuffle" FontSize="16"
                               Foreground="{DynamicResource PlayerIcon}" />
              </Button>
              <Button x:Name="PrevButton" Classes="transport">
                <ic:SymbolIcon Symbol="Previous" FontSize="16" Foreground="{DynamicResource PlayerFg}" />
              </Button>
              <Button x:Name="PlayButton" Classes="playmain" Margin="4,0">
                <ic:SymbolIcon x:Name="PlayIcon" Symbol="Play" IconVariant="Filled" FontSize="18"
                               Foreground="{DynamicResource PlayBtnFg}" />
              </Button>
              <Button x:Name="NextButton" Classes="transport">
                <ic:SymbolIcon Symbol="Next" FontSize="16" Foreground="{DynamicResource PlayerFg}" />
              </Button>
              <Button x:Name="RepeatButton" Classes="transport">
                <Grid>
                  <ic:SymbolIcon x:Name="RepeatIcon" Symbol="ArrowRepeatAll" FontSize="16"
                                 Foreground="{DynamicResource PlayerIcon}" />
                  <TextBlock x:Name="RepeatOneBadge" Text="1" IsVisible="False" FontSize="7.5" FontWeight="Bold"
                             Foreground="{DynamicResource PlayerFg}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-1" />
                </Grid>
              </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="QueueButton" Classes="transport" Margin="0,0,4,0" ToolTip.Tip="播放列表">
                <ic:SymbolIcon Symbol="TextBulletList" FontSize="16" Foreground="{DynamicResource PlayerIcon}" />
              </Button>
              <Button x:Name="DesktopLyricsButton" Classes="transport" Margin="0,0,4,0" ToolTip.Tip="桌面歌词">
                <ic:SymbolIcon x:Name="DesktopLyricsIcon" Symbol="CommentNote" FontSize="16" Foreground="{DynamicResource PlayerIcon}" />
              </Button>
              <ic:SymbolIcon x:Name="VolumeIcon" Symbol="Speaker1" FontSize="16"
                             Foreground="{DynamicResource PlayerIcon}" VerticalAlignment="Center" />
              <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="70" Margin="0,0,4,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

    </Grid>

    <Grid x:Name="NowPlayingOverlay" IsVisible="False" Background="{DynamicResource OverlayBg}">
      <Image x:Name="OverlayBackdrop" Stretch="UniformToFill" Opacity="0.3" />
      <Border Background="{DynamicResource OverlayShade}" />
      <Grid ColumnDefinitions="*,460" Margin="48,40">
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
          <Border CornerRadius="20" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="640" MaxHeight="640" Background="{DynamicResource CoverBg}">
            <Grid>
              <ic:SymbolIcon Symbol="MusicNote2" FontSize="72" Foreground="{DynamicResource PlayerMuted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image x:Name="OverlayCover" Stretch="Uniform" />
            </Grid>
          </Border>
          <local:SpectrumView x:Name="OverlaySpectrum" Width="460" Height="44"
                              HorizontalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1" Margin="40,0,0,0" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="OverlayTitle" Text="" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
            <TextBlock x:Name="OverlaySub" Text="" FontSize="13.5" Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" x:Name="LyricsScroll" Margin="0,24,0,0" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="LyricsPanel" Spacing="14" />
          </ScrollViewer>

          <StackPanel Grid.Row="2" Spacing="10" Margin="0,18,0,0">
            <Grid ColumnDefinitions="*,78">
              <Slider x:Name="OverlaySeek" Minimum="0" Maximum="100" Value="0" MinHeight="30" VerticalAlignment="Center" />
              <TextBlock x:Name="OverlayClock" Grid.Column="1" Text="00:00 / 00:00" HorizontalAlignment="Right"
                         VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PlayerMuted}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <Button x:Name="OverlayShuffle" Classes="transport">
                <ic:SymbolIcon x:Name="OverlayShuffleIcon" Symbol="ArrowShuffle" FontSize="16"
                               Foreground="{DynamicResource PlayerIcon}" />
              </Button>
              <Button x:Name="OverlayPrev" Classes="transport">
                <ic:SymbolIcon Symbol="Previous" FontSize="16" Foreground="{DynamicResource PlayerFg}" />
              </Button>
              <Button x:Name="OverlayPlay" Classes="playmain" Margin="4,0">
                <ic:SymbolIcon x:Name="OverlayPlayIcon" Symbol="Play" IconVariant="Filled" FontSize="18"
                               Foreground="{DynamicResource PlayBtnFg}" />
              </Button>
              <Button x:Name="OverlayNext" Classes="transport">
                <ic:SymbolIcon Symbol="Next" FontSize="16" Foreground="{DynamicResource PlayerFg}" />
              </Button>
              <Button x:Name="OverlayRepeat" Classes="transport">
                <Grid>
                  <ic:SymbolIcon x:Name="OverlayRepeatIcon" Symbol="ArrowRepeatAll" FontSize="16"
                                 Foreground="{DynamicResource PlayerIcon}" />
                  <TextBlock x:Name="OverlayRepeatBadge" Text="1" IsVisible="False" FontSize="7.5" FontWeight="Bold"
                             Foreground="{DynamicResource PlayerFg}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-1" />
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <Button x:Name="CloseOverlayButton" Classes="transport" Width="40" Height="40"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="22">
        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{DynamicResource TextSecondary}" />
      </Button>
    </Grid>
  </Grid>
</Window>
